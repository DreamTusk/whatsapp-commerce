// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                        String    @id @default(cuid())
  name                      String
  phone                     String    @unique
  whatsappPhoneNumberId     String    @unique
  whatsappBusinessAccountId String
  whatsappAccessToken       String
  domain                    String?   @unique
  catalogId                 String?   // WhatsApp Commerce Catalog ID
  address                   String?
  logo                      String?
  minOrderAmount            Float     @default(0)
  deliveryRadius            Float?    // in km, null = no limit
  isActive                  Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  categories  Category[]
  products    Product[]
  orders      Order[]
  customers   Customer[]
  users       User[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // admin, staff
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  createdAt DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  nameLocal String?   // Tamil/Hindi name
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  nameLocal          String?
  description        String?
  price              Float
  imageUrl           String?
  unit               String?  // "500ml", "1kg", "1L", "pack of 6"
  catalogProductId   String?  // Product ID in WhatsApp Catalog (retailer_id)
  inStock            Boolean  @default(true)
  sortOrder   Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id        String                @id @default(cuid())
  phone     String
  name      String?
  latitude  Float?
  longitude Float?
  address   String?
  storeId   String
  store     Store                 @relation(fields: [storeId], references: [id])
  orders    Order[]
  sessions  ConversationSession[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([phone, storeId])
}

model ConversationSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  state      String   @default("WELCOME")
  cartData   Json     @default("[]") // [{productId, name, price, quantity}]
  storeId    String
  expiresAt  DateTime // sessions expire after 24 hours
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                String   @id @default(cuid())
  orderNumber       String   @unique // human-readable like "ORD-0001"
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id])
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id])
  items             Json     // [{productId, name, price, quantity, subtotal}]
  totalAmount       Float
  paymentMethod     String   // "COD" or "ONLINE"
  paymentStatus     String   @default("PENDING") // PENDING, PAID, FAILED
  orderStatus       String   @default("NEW") // NEW, CONFIRMED, PROCESSING, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  latitude          Float?
  longitude         Float?
  address           String?
  razorpayLinkId    String?
  razorpayPaymentId String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MessageLog {
  id            String   @id @default(cuid())
  storeId       String
  customerPhone String
  direction     String   // "INBOUND" or "OUTBOUND"
  messageType   String   // "text", "interactive", "location", "template"
  content       Json
  whatsappMsgId String?
  createdAt     DateTime @default(now())
}
