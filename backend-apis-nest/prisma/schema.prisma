generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Banner {
  id           String      @id @default(cuid())
  storeId      String
  name         String
  type         BannerType
  imageUrl     String?
  isActive     Boolean     @default(true)
  displayOrder Int         @default(0)
  productId    String?
  collectionId String?
  categoryId   String?
  url          String?
  startsAt     DateTime?
  expiresAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Category     Category?   @relation(fields: [categoryId], references: [id])
  Collection   Collection? @relation(fields: [collectionId], references: [id])
  Product      Product?    @relation(fields: [productId], references: [id])
  Store        Store       @relation(fields: [storeId], references: [id])

  @@index([storeId])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  storeId   String
  createdAt DateTime  @default(now())
  Store     Store     @relation(fields: [storeId], references: [id])
  Product   Product[]

  @@unique([name, storeId])
}

model CartItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  storeId    String
  quantity   Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Customer   Customer @relation(fields: [customerId], references: [id])
  Product    Product  @relation(fields: [productId], references: [id])
  Store      Store    @relation(fields: [storeId], references: [id])

  @@unique([customerId, productId])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  imageUrl       String?
  isActive       Boolean    @default(true)
  parentId       String?
  storeId        String
  createdAt      DateTime   @default(now())
  Category       Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category Category[] @relation("CategoryToCategory")
  Store          Store      @relation(fields: [storeId], references: [id])
  Banner         Banner[]
  Product        Product[]
}

model Collection {
  id                String              @id @default(cuid())
  storeId           String
  name              String
  type              CollectionType
  criteria          Json?
  isActive          Boolean             @default(true)
  displayOrder      Int                 @default(0)
  imageUrl          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Banner            Banner[]
  Store             Store               @relation(fields: [storeId], references: [id])
  CollectionProduct CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  position     Int        @default(0)
  addedAt      DateTime   @default(now())
  Collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  Product      Product    @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId])
}

model ConversationSession {
  id         String   @id @default(cuid())
  customerId String
  state      String   @default("WELCOME")
  cartData   Json     @default("[]")
  storeId    String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Customer   Customer @relation(fields: [customerId], references: [id])
}

model Customer {
  id                  String                @id @default(cuid())
  phone               String?
  email               String?
  name                String?
  storeId             String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  CartItem            CartItem[]
  ConversationSession ConversationSession[]
  Store               Store                 @relation(fields: [storeId], references: [id])
  CustomerAddress     CustomerAddress[]
  CustomerToken       CustomerToken[]
  Order               Order[]
  WishlistItem        WishlistItem[]

  @@unique([phone, storeId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  storeId    String
  label      String?
  address    String?
  doorNo     String?
  street     String?
  city       String?
  state      String?
  country    String?
  pincode    String?
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  Customer   Customer @relation(fields: [customerId], references: [id])
  Store      Store    @relation(fields: [storeId], references: [id])
}

model CustomerOtp {
  id        String   @id @default(cuid())
  phone     String
  storeId   String
  otp       String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  Store     Store    @relation(fields: [storeId], references: [id])
}

model CustomerToken {
  id         String   @id @default(cuid())
  jti        String   @unique
  customerId String
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  Customer   Customer @relation(fields: [customerId], references: [id])
}

model Media {
  id           String         @id @default(cuid())
  storeId      String
  key          String         @unique
  bucket       BucketType
  url          String?
  mimeType     String
  size         Int
  originalName String
  entityType   MediaEntity
  entityId     String?
  status       MediaStatus    @default(PENDING)
  thumbnailKey String?
  thumbnailUrl String?
  uploadedBy   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  Store        Store          @relation(fields: [storeId], references: [id])
  User         User?          @relation(fields: [uploadedBy], references: [id])
  ProductMedia ProductMedia[]
}

model MessageLog {
  id            String   @id @default(cuid())
  storeId       String
  customerPhone String
  direction     String
  messageType   String
  content       Json
  whatsappMsgId String?
  createdAt     DateTime @default(now())
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String
  customerId         String
  storeId            String
  totalAmount        Float
  status             OrderStatus @default(NEW)
  address            String?
  doorNo             String?
  street             String?
  city               String?
  state              String?
  country            String?
  pincode            String?
  latitude           Float?
  longitude          Float?
  notes              String?
  altPhone           String?
  cancellationReason String?
  cancelledBy        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  createdBy          String?
  source             OrderSource @default(CUSTOMER)
  Customer           Customer    @relation(fields: [customerId], references: [id])
  Store              Store       @relation(fields: [storeId], references: [id])
  OrderItem          OrderItem[]
  Payment            Payment?

  @@unique([storeId, orderNumber])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  price       Float
  quantity    Int
  subtotal    Float
  Order       Order   @relation(fields: [orderId], references: [id])
  Product     Product @relation(fields: [productId], references: [id])
}

model OtpVerification {
  id        String   @id @default(cuid())
  userId    String
  otp       String
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  razorpayLinkId    String?
  razorpayPaymentId String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  Order             Order         @relation(fields: [orderId], references: [id])
}

model Product {
  id                String              @id @default(cuid())
  name              String
  description       String?
  isActive          Boolean             @default(true)
  sellingPrice      Float               @default(0)
  originalPrice     Float?
  unit              String?
  inStock           Boolean             @default(true)
  brandId           String?
  categoryId        String
  storeId           String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Banner            Banner[]
  CartItem          CartItem[]
  CollectionProduct CollectionProduct[]
  OrderItem         OrderItem[]
  Brand             Brand?              @relation(fields: [brandId], references: [id])
  Category          Category            @relation(fields: [categoryId], references: [id])
  Store             Store               @relation(fields: [storeId], references: [id])
  ProductMedia      ProductMedia[]
  WishlistItem      WishlistItem[]
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  mediaId   String
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  Media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model Store {
  id                        String            @id @default(cuid())
  name                      String
  phone                     String            @unique
  whatsappPhoneNumberId     String?           @unique
  whatsappBusinessAccountId String?
  whatsappAccessToken       String?
  domain                    String?           @unique
  catalogId                 String?
  address                   String?
  logo                      String?
  minOrderAmount            Float             @default(0)
  deliveryRadius            Float?
  isActive                  Boolean           @default(true)
  customerAuthMethods       String[]          @default(["PHONE_OTP"])
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  Banner                    Banner[]
  Brand                     Brand[]
  CartItem                  CartItem[]
  Category                  Category[]
  Collection                Collection[]
  Customer                  Customer[]
  CustomerAddress           CustomerAddress[]
  CustomerOtp               CustomerOtp[]
  Media                     Media[]
  Order                     Order[]
  Product                   Product[]
  StoreInvite               StoreInvite[]
  UserStore                 UserStore[]
  WishlistItem              WishlistItem[]
}

model StoreInvite {
  id        String   @id @default(cuid())
  storeId   String
  email     String
  role      Role     @default(STAFF)
  token     String   @unique
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  Store     Store    @relation(fields: [storeId], references: [id])

  @@unique([email, storeId])
}

model User {
  id              String            @id @default(cuid())
  name            String
  email           String            @unique
  password        String
  isVerified      Boolean           @default(false)
  createdAt       DateTime          @default(now())
  Media           Media[]
  OtpVerification OtpVerification[]
  RefreshToken    RefreshToken[]
  UserStore       UserStore[]
}

model UserStore {
  id        String   @id @default(cuid())
  userId    String
  storeId   String
  role      Role     @default(OWNER)
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)
  Store     Store    @relation(fields: [storeId], references: [id])
  User      User     @relation(fields: [userId], references: [id])

  @@unique([userId, storeId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  productId  String
  storeId    String
  createdAt  DateTime @default(now())
  Customer   Customer @relation(fields: [customerId], references: [id])
  Product    Product  @relation(fields: [productId], references: [id])
  Store      Store    @relation(fields: [storeId], references: [id])

  @@unique([customerId, productId])
}

enum BannerType {
  PRODUCT
  COLLECTION
  URL
  CATEGORY
}

enum BucketType {
  PUBLIC
  PRIVATE
}

enum CollectionType {
  MANUAL
  AUTO
}

enum MediaEntity {
  PRODUCT
  CATEGORY
  BANNER
  STORE
  INVOICE
  DOCUMENT
}

enum MediaStatus {
  PENDING
  ACTIVE
}

enum OrderSource {
  CUSTOMER
  MANUAL
}

enum OrderStatus {
  NEW
  CONFIRMED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Role {
  OWNER
  STAFF
}
