meta {
  name: List Pages Projects
  type: http
  seq: 2
}

get {
  url: https://api.cloudflare.com/client/v4/accounts/{{cloudflare_account_id}}/pages/projects
  body: none
  auth: bearer
}

auth:bearer {
  token: {{cloudflare_api_token}}
}

vars:pre-request {
  cloudflare_account_id: 364a88ccb827c75ddbb9f8d02905e05b
  cloudflare_api_token: YOUR_CLOUDFLARE_API_TOKEN
}

settings {
  encodeUrl: true
  timeout: 0
}
