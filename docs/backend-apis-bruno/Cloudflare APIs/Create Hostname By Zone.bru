meta {
  name: Create Hostname By Zone
  type: http
  seq: 4
}

post {
  url: https://api.cloudflare.com/client/v4/zones/16d8e3c4973bc8a4ae1cfb63e8a63be2/custom_hostnames
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer YOUR_CLOUDFLARE_API_TOKEN
  Content-Type: application/json
}

body:json {
  {
    "hostname": "www.dreamkids.in",
    "ssl": {
      "method": "http",
      "type": "dv",
      "bundle_method": "ubiquitous"
    }
  }
}

settings {
  encodeUrl: false
  forwardAuthorizationHeader: false
}
