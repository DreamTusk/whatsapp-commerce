meta {
  name: Update
  type: http
  seq: 3
}

put {
  url: {{base_url_local}}/payment-providers/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "key_id": "rzp_live_xxxxxxxxxxxx",
    "is_active": true
  }
}

docs {
  OWNER only. Update key_id, key_secret, or is_active.
  Omit key_secret to keep the existing encrypted value unchanged.
  If key_secret is provided it will be re-encrypted before saving.

  Response: { payment_provider: { id, provider, key_id, is_active, created_at, updated_at } }
}

settings {
  encodeUrl: true
  timeout: 0
}
