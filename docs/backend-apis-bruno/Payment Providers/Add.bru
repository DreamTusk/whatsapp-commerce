meta {
  name: Add
  type: http
  seq: 2
}

post {
  url: {{base_url_local}}/payment-providers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "provider": "RAZORPAY",
    "key_id": "rzp_test_xxxxxxxxxxxx",
    "key_secret": "your_key_secret_here"
  }
}

docs {
  OWNER only. Adds a new payment provider for the store.
  keySecret is encrypted with AES-256-GCM before saving — never stored in plain text.

  provider: "RAZORPAY" | "STRIPE" | "PAYU"
  One config per provider per store (@@unique[storeId, provider]).
  isActive defaults to false — toggle separately after adding.

  Response: { payment_provider: { id, provider, key_id, is_active, created_at, updated_at } }
}

settings {
  encodeUrl: true
  timeout: 0
}
