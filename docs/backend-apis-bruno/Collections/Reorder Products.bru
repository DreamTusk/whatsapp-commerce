  auth: inherit
}

params:path {
  id: COLLECTION_ID
}

body:json {
  {
    "product_ids": ["PRODUCT_ID_1", "PRODUCT_ID_2", "PRODUCT_ID_3"]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
