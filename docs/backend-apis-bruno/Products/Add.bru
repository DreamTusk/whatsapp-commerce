meta {
  name: Add Product
  type: http
  seq: 2
}

post {
  url: {{base_url_local}}/products
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  name: Fresh Apples
  name_local:
  description: Fresh imported apples
  selling_price: 99
  original_price: 120
  category_id:
  brand_id:
  sort_order: 0
  is_active: true
  in_stock: true
  image:
}

settings {
  encodeUrl: true
  timeout: 0
}
