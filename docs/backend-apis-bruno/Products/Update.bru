meta {
  name: Update Product
  type: http
  seq: 3
}

put {
  url: {{base_url_local}}/products/:id
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  ~name:
  ~name_local:
  ~description:
  ~selling_price:
  ~original_price:
  ~category_id:
  ~brand_id:
  ~sort_order:
  ~is_active:
  ~in_stock:
  ~image:
}

settings {
  encodeUrl: true
  timeout: 0
}
