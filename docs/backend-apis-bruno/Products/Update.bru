meta {
  name: Update Product
  type: http
  seq: 3
}

put {
  url: {{base_url_local}}/products/:id
  body: json
  auth: inherit
}

params:path {
  id: product_id_here
}

body:json {
  {
    "name": "Updated Name",
    "description": "Updated description",
    "selling_price": "99",
    "original_price": "120",
    "category_id": "",
    "brand_id": "",
    "is_active": "true",
    "in_stock": "true",
    "unit": "kg",
    "media_id": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
