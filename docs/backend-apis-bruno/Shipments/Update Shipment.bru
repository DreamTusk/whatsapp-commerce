meta {
  name: Update Shipment
  type: http
  seq: 3
}

put {
  url: {{base_url_local}}/shipments/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

params:path {
  id: <shipment_id>
}

body:json {
  {
    "carrier_name": "Delhivery",
    "tracking_id": "DL123456789",
    "tracking_url": "https://www.delhivery.com/track/package/DL123456789"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
