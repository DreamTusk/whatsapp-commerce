meta {
  name: Update Category
  type: http
  seq: 3
}

put {
  url: {{base_url_local}}/categories/:id
  body: json
  auth: inherit
}

params:path {
  id: category_id_here
}

body:json {
  {
    "name": "Fruits & Vegetables",
    "is_active": "true",
    "parent_id": "",
    "media_id": "",
    "remove_image": "false"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
