meta {
  name: Add to Cart
  type: http
  seq: 2
}

post {
  url: {{base_url_local}}/storefront/cart
  body: json
  auth: bearer
}

headers {
  x-store-domain: freshmart.localhost
}

auth:bearer {
  token: {{customer_access_token}}
}

body:json {
  {
    "product_id": "cmphymhwi00031hrbbsi0vagk",
    "quantity": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
