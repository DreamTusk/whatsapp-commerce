meta {
  name: Place Order (Online)
  type: http
  seq: 2
}

post {
  url: {{base_url_local}}/storefront/orders
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customer_access_token}}
}

headers {
  x-store-domain: freshmart.localhost
}

body:json {
  {
    "items": [
      { "product_id": "<product_id>", "quantity": 2 }
    ],
    "address": "12 Anna Nagar, Chennai - 600040",
    "payment_method": "ONLINE"
  }
}

docs {
  Place an order with online payment (Razorpay).
  Store must have an active Razorpay provider configured — otherwise returns 400.

  On success returns:
  {
    order: { id, order_number, status: "NEW", ... },
    razorpay_order_id: "order_xxxx",
    razorpay_key_id: "rzp_test_xxxx",
    amount_paise: 49900
  }

  Frontend uses razorpay_key_id + razorpay_order_id to open Checkout.js modal.
  After customer pays, call POST /storefront/orders/:id/verify-payment to confirm.
}

settings {
  encodeUrl: true
  timeout: 0
}
