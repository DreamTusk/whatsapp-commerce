meta {
  name: Get Store Info
  type: http
  seq: 1
}

get {
  url: {{base_url_local}}/store/info
  body: none
  auth: none
}

headers {
  x-store-domain: freshmart.localhost
}

docs {
  Response includes store, banners, and collections in one request.

  banners[]: id, name, type (product|collection|url), image_url, product_id, collection_id, url
  - Only active banners within their starts_at / expires_at window are returned.
  - Ordered by display_order asc.

  collections[]: id, name, type (manual|auto), image_url, products[]
  - Only is_active=true collections returned, ordered by display_order asc.
  - Auto collections resolve products live via criteria.
}

settings {
  encodeUrl: true
  timeout: 0
}
