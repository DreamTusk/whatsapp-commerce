meta {
  name: Subscribe to a WABA
  type: http
  seq: 1
}

post {
  url: https://graph.facebook.com/{{Version}}/{{WABA-ID}}/subscribed_apps
  body: none
  auth: none
}

docs {
  Subscribe an app to a WhatsApp Business Account. For more information about subscribing to a WhatsApp Business Account, see [Subscribe to a WhatsApp Business Account](https://developers.facebook.com/docs/whatsapp/embedded-signup/webhooks#subscribe-to-a-whatsapp-business-account).
}