meta {
  name: Get Endpoint Availability Metric
  type: http
  seq: 5
}

get {
  url: https://graph.facebook.com/{{Version}}/{{Flow-ID}}?fields=metric.name(ENDPOINT_AVAILABILITY).granularity(DAY).since(2024-01-28).until(2024-01-30)
  body: none
  auth: bearer
}

auth:bearer {
  token: {{User-Access-Token}}
}


params:query {
  fields: metric.name(ENDPOINT_AVAILABILITY).granularity(DAY).since(2024-01-28).until(2024-01-30)
}

docs {
  Can request specific fields by enabling the \`fields\` query param
}