meta {
  name: Update Flow Metadata
  type: http
  seq: 3
}

post {
  url: https://graph.facebook.com/{{Version}}/{{Flow-ID}}
  body: form-multipart
  auth: bearer
}

auth:bearer {
  token: {{User-Access-Token}}
}


body:multipart-form {
  name: <NEW_FLOW_NAME>
  categories: ["OTHER"]
  endpoint_uri: https://example.com
}