meta {
  name: Block user(s)
  type: http
  seq: 2
}

post {
  url: https://graph.facebook.com/{{Version}}/{{Phone-Number-ID}}/block_users
  body: json
  auth: bearer
}

auth:bearer {
  token: {{User-Access-Token}}
}


body:json {
  {
      "messaging_product": "whatsapp",
      "block_users": [
          {
              "user": "{{Recipient-Phone-Number}}"
          }
      ]
  }
}

docs {
  - Guide: [Block Users](https://developers.facebook.com/docs/whatsapp/cloud-api/block-users)
      
  - Endpoint reference: [POST WhatsApp Buiness Phone Number &gt; block_users](https://developers.facebook.com/docs/graph-api/reference/whats-app-business-account-to-number-current-status/block_users/#Creating)
}