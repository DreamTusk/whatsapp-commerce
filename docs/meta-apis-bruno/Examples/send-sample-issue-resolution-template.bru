meta {
  name: Send Sample Issue Resolution Template
  type: http
  seq: 3
}

post {
  url: https://graph.facebook.com/{{Version}}/{{Phone-Number-ID}}/messages
  body: json
  auth: bearer
}

auth:bearer {
  token: {{User-Access-Token}}
}


body:json {
  {
     "messaging_product": "whatsapp",
     "to": "{{Recipient-Phone-Number}}",
     "type": "template",
     "template": {
         "name": "sample_issue_resolution",
         "language": {
             "code": "en_US",
             "policy": "deterministic"
         },
         "components": [
             {
                 "type": "body",
                 "parameters": [
                     {
                         "type": "text",
                         "text": "*Mr. Jones*"
                     }
                 ]
             },
             {
                 "type": "button",
                 "sub_type": "quick_reply",
                 "index": 0,
                 "parameters": [
                     {
                         "type": "text",
                         "text": "Yes"
                     }
                 ]
             },
             {
                 "type": "button",
                 "sub_type": "quick_reply",
                 "index": 1,
                 "parameters": [
                     {
                         "type": "text",
                         "text": "No"
                     }
                 ]
             }
         ]
     }
  }
}