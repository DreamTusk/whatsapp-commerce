  body: none
  auth: bearer
}

auth:bearer {
  token: {{User-Access-Token}}
}


params:query {
  fields: conversation_analytics.start(1656661480).end(1674859480).granularity(MONTHLY).conversation_directions(["business_initiated"]).dimensions(["conversation_type", "conversation_direction"])
}

