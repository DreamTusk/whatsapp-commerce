# Database
# Local dev (matches docker-compose.yml): docker compose up -d
DATABASE_URL=postgresql://postgres:postgres123@localhost:5433/whatsapp_commerce

# Server
PORT=3010
NODE_ENV=development

# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
WHATSAPP_PHONE_NUMBER_ID=from_meta_dashboard
WHATSAPP_BUSINESS_ACCOUNT_ID=from_meta_dashboard
WHATSAPP_ACCESS_TOKEN=from_meta_dashboard

# Encryption (AES-256-GCM) — used to encrypt payment provider key secrets in DB
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Cloudflare R2 (file storage)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BUCKET=your_public_bucket_name
R2_PRIVATE_BUCKET=your_private_bucket_name
R2_URL=https://your_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your_public_bucket_subdomain.r2.dev

# JWT
# Generate with: openssl rand -hex 64
JWT_SECRET=your_admin_jwt_secret
CUSTOMER_JWT_SECRET=your_customer_jwt_secret

# Email (ZeptoMail) — API token must include the "Zoho-enczapikey " prefix as shown in the dashboard
ZEPTOMAIL_API_TOKEN=your_zeptomail_send_mail_token
ZEPTOMAIL_FROM_EMAIL=your_verified_sender_email
ZEPTOMAIL_FROM_NAME=your_sender_name
ZEPTOMAIL_TEMPLATE_KEY_SIGNUP_OTP=your_signup_otp_template_key
ZEPTOMAIL_TEMPLATE_KEY_FORGOT_PASSWORD=your_forgot_password_template_key
ZEPTOMAIL_TEMPLATE_KEY_INVITE=your_staff_invite_template_key
ZEPTOMAIL_TEMPLATE_KEY_INVOICE=your_order_invoice_template_key
ZEPTOMAIL_TEMPLATE_KEY_STORE_CREATED=your_store_created_template_key
ZEPTOMAIL_TEMPLATE_KEY_STORE_UPDATED=your_store_updated_template_key
ZEPTOMAIL_TEMPLATE_KEY_STORE_ACTIVATED=your_store_activated_template_key
ZEPTOMAIL_TEMPLATE_KEY_STORE_DEACTIVATED=your_store_deactivated_template_key
# Defaults to the global region (api.zeptomail.com) — override if your ZeptoMail account is on a different region
# (check which domain you log into ZeptoMail with: zeptomail.com / zeptomail.in / zeptomail.eu)
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email/template

# App
APP_URL=http://localhost:3012
ADMIN_APP_URL=http://localhost:3011

# Google OAuth (admin login) — Client ID only, no secret needed for ID-token verification
# Console: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Custom domain feature — Cloudflare for SaaS / Custom Hostnames API (distinct
# from the plain CLOUDFLARE_API_TOKEN/CLOUDFLARE_ACCOUNT_ID used by
# ci-cd-setup.md's Wrangler deploy step, which is unrelated to this) — production only
CUSTOM_DOMAIN_CLOUDFLARE_TOKEN=your_cloudflare_zone_scoped_api_token
CUSTOM_DOMAIN_CLOUDFLARE_ZONE_ID=your_dreambiz_app_zone_id
CUSTOM_DOMAIN_CNAME_TARGET=storefront.dreambiz.app
